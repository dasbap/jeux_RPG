{
  "name": "jeux-rpg-desktop",
  "version": "0.11.0",
  "private": true,
  "description": "Client de Jeux RPG : solo hors ligne et multijoueur",
  "author": "Jeux RPG",
  "main": "main.cjs",
  "scripts": {
    "prepare:client": "node build.cjs --prepare-only",
    "start": "node build.cjs --start",
    "build:win": "node build.cjs",
    "build:linux": "node build.cjs --linux",
    "test": "npm run prepare:client && node --test test/*.test.cjs"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "pyodide": "314.0.7"
  },
  "overrides": {
    "minimatch@9.0.9": "11.0.6",
    "minimatch@10.2.6": "11.0.6"
  },
  "build": {
    "appId": "fr.jeux-rpg.client",
    "productName": "Jeux RPG",
    "artifactName": "Jeux-RPG.${ext}",
    "directories": {"output": "../dist/client"},
    "files": ["main.cjs", "runtime.cjs", "assets/**/*", "package.json"],
    "win": {
      "target": [{"target": "portable", "arch": ["x64"]}],
      "executableName": "Jeux-RPG",
      "signAndEditExecutable": false
    },
    "portable": {"requestExecutionLevel": "user"},
    "linux": {
      "target": [{"target":"AppImage","arch":["x64"]},{"target":"tar.gz","arch":["x64"]}],
      "executableName": "jeux-rpg",
      "artifactName": "Jeux-RPG-Linux-${arch}.${ext}",
      "category": "Game",
      "maintainer": "Jeux RPG",
      "desktop": {"entry":{"Name":"Jeux RPG","Comment":"Les Cloches sous les racines — RPG solo et multijoueur"}}
    }
  }
}
